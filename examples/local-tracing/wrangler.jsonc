{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "local-tracing-example",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "kv_namespaces": [
    {
      "binding": "CARTS",
      "id": "local-tracing-example-carts"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "local-tracing-example-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
