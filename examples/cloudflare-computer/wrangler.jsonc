{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudflare-computer-example",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "WORKSPACE", "class_name": "WorkspaceDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["WorkspaceDO"] }
  ],
  // Cloudflare Access で保護する（ https://developers.cloudflare.com/workers/configuration/cloudflare-access/ ）。
  // ここは `wrangler dev` 用のローカルシミュレーションのみで、本番の Access
  // アプリケーション（許可ポリシー）は Zero Trust ダッシュボードで別途作成する
  // 必要がある。手順は README.md の「Cloudflare Access 設定」を参照。
  // aud は本番の Access アプリケーション作成後、実際の値に置き換えること。
  "access": {
    "dev": {
      "aud": "cloudflare-computer-example-dev",
      "identity": { "email": "syumai@gmail.com" }
    }
  }
}
