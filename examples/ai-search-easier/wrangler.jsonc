{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "example-ai-search-easier",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-16",
  "ai_search_namespaces": [
    {
      "binding": "AI_SEARCH",
      // "wrangler ai-search create ... --namespace example-ai-search" で
      // 事前にこの名前空間を作成しておく必要がある（README参照）。
      "namespace": "example-ai-search"
    }
  ],
  "observability": {
    "enabled": true
  },
  // Cloudflare Access で保護する（ https://developers.cloudflare.com/workers/configuration/cloudflare-access/ ）。
  // ここは `wrangler dev` 用のローカルシミュレーションのみで、本番の Access
  // アプリケーション（許可ポリシー）は Zero Trust ダッシュボードで別途作成する
  // 必要がある。手順は README.md の「Cloudflare Access 設定」を参照。
  // aud は本番の Access アプリケーション作成後、実際の値に置き換えること。
  "access": {
    "dev": {
      "aud": "example-ai-search-easier-dev",
      "identity": { "email": "syumai@gmail.com" }
    }
  }
}
