{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "example-introducing-radar-researcher",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-16",
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true
  },
  // RADAR_API_TOKEN は secret として別途設定する（任意。README参照）。
  // Cloudflare Access で保護する（ https://developers.cloudflare.com/workers/configuration/cloudflare-access/ ）。
  // ここは `wrangler dev` 用のローカルシミュレーションのみで、本番の Access
  // アプリケーション（許可ポリシー）は Zero Trust ダッシュボードで別途作成する
  // 必要がある。手順は README.md の「Cloudflare Access 設定」を参照。
  // aud は本番の Access アプリケーション作成後、実際の値に置き換えること。
  "access": {
    "dev": {
      "aud": "example-introducing-radar-researcher-dev",
      "identity": { "email": "syumai@gmail.com" }
    }
  }
}
